    {
      "name": "14 · Modificar PDF y reemplazarlo en S3",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{ticketsUrl}}/api/tickets/{{ticket1}}",
        "description": "Ve inmediatamente a S3, actualiza y muestra Last modified. Descarga el PDF actualizado.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titular\": \"Ana Pérez González\",\n  \"asiento\": \"B-12\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Misma clave\", () => pm.expect(pm.response.json().s3Key).to.eql(pm.collectionVariables.get(\"s3Key1\")));",
              "pm.test(\"Contenido cambió\", () => pm.expect(pm.response.json().sha256).not.to.eql(pm.collectionVariables.get(\"sha256_1\")));",
              "pm.collectionVariables.set(\"sha256_1\", pm.response.json().sha256);"
            ]
          }
        }
      ]
    },
