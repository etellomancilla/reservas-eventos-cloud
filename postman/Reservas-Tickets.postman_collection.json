    {
      "name": "11 · Descargar PDF desde S3",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{ticketsUrl}}/api/tickets/{{ticket1}}/archivo",
        "description": "Guarda la respuesta como archivo, abre el PDF y compara SHA-256 con shasum -a 256."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"PDF\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/pdf\"));",
              "pm.test(\"Hash esperado\", () => pm.expect(pm.response.headers.get(\"X-Checksum-SHA256\")).to.eql(pm.collectionVariables.get(\"sha256_1\")));"
            ]
          }
        }
      ]
    },
