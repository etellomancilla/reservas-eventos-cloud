{
  "info": {
    "name": "Reservas y Tickets · Evaluación Cloud",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden. Cada ejecución crea un evento y usuarios nuevos. Pausar tras generar/modificar/borrar para mostrar S3. El PDF conserva el estado de reserva al momento de emitirlo."
  },
  "item": [
    {
      "name": "01 · Salud Reservas",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{reservasUrl}}/actuator/health",
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Servicio UP\", () => pm.expect(pm.response.json().status).to.eql(\"UP\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 · Salud Tickets",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{ticketsUrl}}/actuator/health",
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 · Crear evento",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{reservasUrl}}/api/eventos",
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Conferencia Cloud\",\n  \"fecha\": \"{{fechaEvento}}\",\n  \"capacidad\": 10,\n  \"precio\": 15000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const now = Date.now();",
              "pm.collectionVariables.set(\"fechaEvento\", new Date(now + 30*86400000).toISOString());",
              "pm.collectionVariables.set(\"desde\", new Date(now - 60000).toISOString());",
              "pm.collectionVariables.set(\"hasta\", new Date(now + 86400000).toISOString());",
              "pm.collectionVariables.set(\"usuarioX\", \"usuarioX\" + now);",
              "pm.collectionVariables.set(\"usuarioY\", \"usuarioY\" + now);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"eventoId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 · Crear reserva 1 (PAGADA)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{reservasUrl}}/api/reservas",
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventoId\": \"{{eventoId}}\",\n  \"usuarioId\": \"{{usuarioX}}\",\n  \"estado\": \"PAGADA\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"reserva1\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 · Generar ticket 1 y subir automáticamente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{ticketsUrl}}/api/tickets",
        "description": "Después de enviar, abre AWS S3, actualiza el bucket y muestra la clave s3Key. Comprueba también el PDF en EFS.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reservaId\": \"{{reserva1}}\",\n  \"titular\": \"Ana Pérez\",\n  \"asiento\": \"A-1\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"ticket1\", pm.response.json().id);",
              "pm.test(\"Subida automática\", () => pm.expect(pm.response.json().estadoArchivo).to.eql(\"SINCRONIZADO\"));",
              "pm.collectionVariables.set(\"s3Key1\", pm.response.json().s3Key);",
              "pm.collectionVariables.set(\"sha256_1\", pm.response.json().sha256);"
            ]
          }
        }
      ]
    },
